{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run FolkFight (built exe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/FolkFight.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/output",
            "environment": [],
            "externalConsole": false,
            "noDebug": true,
            "console": "integratedTerminal",
            "preLaunchTask": "build-release"
        },
        {
            "name": "Attach with gdb (requires working gdb.exe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/output/FolkFight.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/output",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${workspaceFolder}/toolchain/gdb/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "build-release"
        }
    ]
}
